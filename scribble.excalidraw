      "text": "for r in n:\n    for c in k:\n        sum = 0\n        for i in m:\n            sum += A[r, i] * B[i,c]\n            // which is equal to (A  row major, B col major):\n            sum += A[r*m + i] * B[i*k +c]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "for r in n:\n    for c in k:\n        sum = 0\n        for i in m:\n            sum += A[r, i] * B[i,c]\n            // which is equal to (A  row major, B col major):\n            sum += A[r*m + i] * B[i*k +c]",
      "autoResize": true,
      "lineHeight": 1.25
